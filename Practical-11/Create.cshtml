@model StudentCampusPortal.Models.ServiceRequest
@{
    ViewData["Title"] = "Create Request";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="mb-0 fw-bold text-primary">Create Campus Service Request</h4>
                <p class="text-muted small mb-0">Fill in the details below to raise a campus service ticket.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="StudentName" class="form-label fw-semibold">Student Name <span class="text-danger">*</span></label>
                        <input asp-for="StudentName" class="form-control" placeholder="e.g. Yash Sejpal" />
                        <span asp-validation-for="StudentName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                        <input asp-for="Department" class="form-control" placeholder="e.g. Computer Engineering" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ServiceType" class="form-label fw-semibold">Service Type <span class="text-danger">*</span></label>
                            <select asp-for="ServiceType" class="form-select">
                                <option value="">-- Select Service Type --</option>
                                <option value="IT Support">IT Support (Wi-Fi, PC, Lab)</option>
                                <option value="Library">Library (Books, IEEE, Portal)</option>
                                <option value="Maintenance">Maintenance (AC, Projector, Electrical)</option>
                                <option value="Transport">Transport (Bus, Parking, Pass)</option>
                            </select>
                            <span asp-validation-for="ServiceType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority <span class="text-danger">*</span></label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Problem Description <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the problem or service needed in detail..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            &larr; Back to List
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            Submit Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
